<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FanBets" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/red_primary</item>
        <item name="android:navigationBarColor">@color/red_primary</item>
    </style>

    <style name="BrowserWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/browser_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/browser_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/browser_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/browser_fade_out</item>
    </style>

    <style name="Theme.FanBets.Browser" parent="Theme.FanBets">
        <item name="android:windowBackground">@color/browser_activity_background</item>
        <item name="android:statusBarColor">@color/browser_activity_background</item>
        <item name="android:navigationBarColor">@color/browser_activity_background</item>
        <item name="android:windowAnimationStyle">@style/BrowserWindowAnimation</item>
        <item name="android:colorAccent">@color/browser_loader_color</item>
        <item name="colorControlActivated">@color/browser_loader_color</item>
    </style>
</resources>
